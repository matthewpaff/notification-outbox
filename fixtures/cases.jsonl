{"description": "reject unsupported outbox actions", "expected_error": true, "id": "outbox-0000", "input": {"events": [{"action": "unknown", "id": "notice-0"}]}}
{"description": "reject commits without a record value", "expected_error": true, "id": "outbox-0001", "input": {"events": [{"action": "commit", "id": "notice-1"}]}}
{"description": "reject non-boolean transaction failure flags", "expected_error": true, "id": "outbox-0002", "input": {"events": [{"action": "commit", "fail": "yes", "id": "notice-2", "value": {"sample": 2, "topic": "notification"}}]}}
{"description": "reject sends for uncommitted record IDs", "expected_error": true, "id": "outbox-0003", "input": {"events": [{"action": "send", "id": "notice-3", "succeed": true}]}}
{"description": "reject conflicting duplicate record IDs", "expected_error": true, "id": "outbox-0004", "input": {"events": [{"action": "commit", "fail": false, "id": "notice-4", "value": {"sample": 4, "topic": "notification"}}, {"action": "commit", "fail": false, "id": "notice-4", "value": {"sample": 5}}]}}
{"description": "roll back record writes when the outbox transaction fails", "expected": {"outbox": [], "records": [], "results": [{"action": "commit", "id": "notice-5", "outcome": "rolled_back"}]}, "id": "outbox-0005", "input": {"events": [{"action": "commit", "fail": true, "id": "notice-5", "value": {"sample": 5, "topic": "notification"}}]}}
{"description": "commit a record and mark its outbox entry sent", "expected": {"outbox": [{"attempts": 1, "id": "notice-6", "status": "sent"}], "records": [{"id": "notice-6", "value": {"sample": 6, "topic": "notification"}}], "results": [{"action": "commit", "id": "notice-6", "outcome": "stored"}, {"action": "send", "id": "notice-6", "outcome": "sent"}]}, "id": "outbox-0006", "input": {"events": [{"action": "commit", "fail": false, "id": "notice-6", "value": {"sample": 6, "topic": "notification"}}, {"action": "send", "id": "notice-6", "succeed": true}]}}
{"description": "deduplicate identical record commits", "expected": {"outbox": [{"attempts": 1, "id": "notice-7", "status": "sent"}], "records": [{"id": "notice-7", "value": {"sample": 7, "topic": "notification"}}], "results": [{"action": "commit", "id": "notice-7", "outcome": "stored"}, {"action": "commit", "id": "notice-7", "outcome": "duplicate"}, {"action": "send", "id": "notice-7", "outcome": "sent"}]}, "id": "outbox-0007", "input": {"events": [{"action": "commit", "fail": false, "id": "notice-7", "value": {"sample": 7, "topic": "notification"}}, {"action": "commit", "fail": false, "id": "notice-7", "value": {"sample": 7, "topic": "notification"}}, {"action": "send", "id": "notice-7", "succeed": true}]}}
